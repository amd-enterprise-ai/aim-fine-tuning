defaults:
  numbered: false
  maxdepth: 2
root: README
subtrees:
  - entries:
      - file: recipes
        title: Recipes
      - file: guides/guides
        title: Guides
        subtrees:
          - entries:
              - file: guides/quickstart
                title: Quickstart
              - file: guides/mount-recipes
                title: Mount your own recipes
              - file: guides/standalone-finetuning
                title: Run standalone fine-tuning on Kubernetes
      - file: reference/reference
        title: Reference
        subtrees:
          - entries:
              - file: reference/standard-interfaces
                title: Standard interfaces
                subtrees:
                  - entries:
                      - file: reference/standard-sft-image-interface
                        title: SFT Interface
              - file: reference/recipe-schema
                title: Recipe schema
              - file: reference/engines
                title: Engines
                subtrees:
                  - entries:
                      - file: reference/engines/aimfttk
                        title: AIM Fine-tuning Toolkit (aimfttk)
