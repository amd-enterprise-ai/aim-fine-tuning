# Pass the engine image pinned by digest (name:tag@sha256:...) so the recorded build info is exact.
ARG ENGINE_IMAGE=docker.io/amdenterpriseai/aimfttk:0.2.6-rocm7.14
FROM ${ENGINE_IMAGE} AS dev
ARG ENGINE_IMAGE

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AIMFT_BACKEND=aimfttk \
    AIMFT_METHOD=SFT

WORKDIR /workspace

# Install the wrapper in its own virtual environment so its dependencies do not
# modify the fine-tuning engine environment inherited from the base image.
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /bin/uv
COPY aim_fine_tune /tmp/aim_fine_tune
RUN UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/aim_fine_tune \
    uv sync --locked --no-dev --no-editable --project /tmp/aim_fine_tune \
    && ln -sf /opt/aim_fine_tune/bin/aim_fine_tune /usr/bin/aim_fine_tune \
    && rm -rf /tmp/aim_fine_tune /bin/uv \
    && printf '{\n  "engineImage": "%s"\n}\n' "${ENGINE_IMAGE}" > /opt/aim_fine_tune/build-info.json

ENTRYPOINT ["aim_fine_tune", "train", "--execute"]
CMD []

FROM dev AS release

# build-staging is generated by aimft_catalog: the recipes directory carries its aimft-recipe-compatibility.yaml.
COPY build-staging/recipes /opt/aim_fine_tune/builtin_recipes
COPY build-staging/build-manifest.json /opt/aim_fine_tune/build-manifest.json
